{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // module/moduleResolution are inherited as NodeNext/NodeNext from base.json — matches the
    // explicit ".js" relative-import specifiers used throughout the source. The older
    // module:CommonJS + moduleResolution:Node combo (Node's package.json has no "type" field,
    // so NodeNext still emits CommonJS here) is deprecated as of TS 5.9 ("node10" resolution,
    // removed in TS 7).
    "target": "ES2023",
    "lib": ["ES2023"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "dist",
    // `composite: true` (inherited from base.json) silently breaks `tsc --watch` emission —
    // it reports "0 errors" but writes no files — which breaks `nest start --watch`. Nest's
    // own build/watch tooling doesn't use TS project references, so composite mode buys
    // nothing here; disable it the same way react.json does.
    "composite": false,
    "declarationMap": false
  }
}
